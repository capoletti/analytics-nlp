# Application Settings
APP_NAME="Analytics Platform Backend"
DEBUG=false
LOG_LEVEL=INFO
LOG_FORMAT=json

# PostgreSQL Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=analytics
POSTGRES_POOL_SIZE=20
POSTGRES_MAX_OVERFLOW=10

# Trino Configuration
TRINO_HOST=localhost
TRINO_PORT=8443
TRINO_HTTP_SCHEME=https
# CA que assinou o certificado do Trino (vazio = CAs do sistema)
TRINO_CA_CERT_PATH=/run/secrets/trino-ca/ca.crt
# Diretório com um arquivo de senha por usuário Trino do tenant (ex.: user_empresa1)
TRINO_PASSWORDS_DIR=/run/secrets/trino
TRINO_TENANT_USER_PREFIX=user_
TRINO_CATALOG=iceberg
TRINO_SCHEMA_PREFIX=default

# Redis Configuration
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=true
CACHE_TTL_SECONDS=300

# Security
JWT_SECRET=your-super-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Tenants
VALID_TENANTS=empresa1,empresa2,empresa3

# Fallback Storage
FALLBACK_STORAGE_ENABLED=true
FALLBACK_STORAGE_PATH=/tmp/dashboards.json
