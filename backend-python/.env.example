# Application Settings
APP_NAME="Analytics Platform Backend"
DEBUG=false
LOG_LEVEL=INFO
LOG_FORMAT=json

# PostgreSQL Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=analytics
POSTGRES_POOL_SIZE=20
POSTGRES_MAX_OVERFLOW=10

# Trino Configuration
TRINO_HOST=localhost
TRINO_PORT=8080
TRINO_CATALOG=iceberg
TRINO_SCHEMA_PREFIX=default

# Redis Configuration
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=true
CACHE_TTL_SECONDS=300

# Security
# Must be a random value with >= 32 chars (e.g. `openssl rand -hex 32`); the default is rejected
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Tenants
VALID_TENANTS=["empresa1","empresa2","empresa3"]
# JSON tenant -> scrypt hash, generated with `python scripts/hash_password.py`
TENANT_PASSWORD_HASHES={}

# Fallback Storage
FALLBACK_STORAGE_ENABLED=true
FALLBACK_STORAGE_PATH=/tmp/dashboards.json
